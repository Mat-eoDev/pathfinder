<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PathFinder.MainPage"
             BackgroundColor="#0A0A0F">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="25">
            
            <!-- Header avec gradient effet -->
            <Border StrokeThickness="0" 
                    BackgroundColor="#1A1A2E"
                    Padding="30,25">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#8B5CF6" Opacity="0.3" Radius="20" Offset="0,5" />
                </Border.Shadow>
                
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="12">
                        <Label Text="🎯 PathFinder" 
                               FontSize="32" 
                               FontAttributes="Bold"
                               TextColor="#06B6D4"
                               HorizontalOptions="Start" />
                        
                        <Label Text="Scanner de Réseau &amp; Vulnérabilités" 
                               FontSize="15" 
                               TextColor="#94A3B8" 
                               HorizontalOptions="Start"
                               FontAttributes="Italic" />
                        
                        <HorizontalStackLayout Spacing="8" Margin="0,5,0,0">
                            <Label x:Name="UserLabel"
                                   Text="👤 Connecté"
                                   FontSize="12"
                                   TextColor="#10B981"
                                   VerticalOptions="Center" />
                            <Border x:Name="TierBadge"
                                    Padding="8,2"
                                    BackgroundColor="#334155"
                                    Stroke="#94A3B8"
                                    StrokeThickness="1">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                <Label x:Name="TierBadgeLabel"
                                       Text="🆓 Free"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#E2E8F0"/>
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    
                    <Button Grid.Column="1"
                            x:Name="LogoutButton"
                            Text="🚪 Déconnexion"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="#EF4444"
                            CornerRadius="10"
                            Padding="15,10"
                            VerticalOptions="Start"
                            Clicked="OnLogoutClicked">
                        <Button.Shadow>
                            <Shadow Brush="#EF4444" Opacity="0.4" Radius="8" Offset="0,3" />
                        </Button.Shadow>
                    </Button>
                </Grid>
            </Border>

            <!-- Carte Informations Réseau -->
            <Border StrokeThickness="2" 
                    Stroke="#8B5CF6"
                    BackgroundColor="#16213E"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#06B6D4" Opacity="0.2" Radius="15" Offset="0,3" />
                </Border.Shadow>
                
                <VerticalStackLayout Spacing="18">
                    <Label Text="📡 INFORMATIONS RÉSEAU" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="#06B6D4" />
                    
                    <!-- IP Locale avec badge -->
                    <Border BackgroundColor="#1A1A2E" 
                            Padding="15,12"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="💻" FontSize="20" VerticalOptions="Center" />
                            <Label x:Name="LocalIPLabel"
                                   Text="Détection de votre IP..." 
                                   FontSize="15" 
                                   TextColor="#E2E8F0"
                                   VerticalOptions="Center" 
                                   HorizontalOptions="FillAndExpand" />
                        </HorizontalStackLayout>
                    </Border>
                    
                    <Label Text="CIBLE(S) — une par ligne : IP, hostname ou CIDR" 
                           FontSize="13" 
                           FontAttributes="Bold" 
                           TextColor="#8B5CF6"
                           Margin="0,5,0,0" />
                    
                    <Border BackgroundColor="#0A0A0F" 
                            StrokeThickness="2"
                            Stroke="#8B5CF6"
                            Padding="3">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Editor x:Name="TargetEditor"
                                Text="192.168.1.0/24"
                                Placeholder="Ex : 192.168.1.0/24&#10;10.0.0.5&#10;exemple.local"
                                PlaceholderColor="#64748B"
                                BackgroundColor="#1A1A2E"
                                TextColor="#E2E8F0"
                                FontSize="14"
                                HeightRequest="95"
                                AutoSize="TextChanges"
                                Margin="5" />
                    </Border>

                    <Label Text="MODE DE SCAN"
                           FontSize="13" 
                           FontAttributes="Bold" 
                           TextColor="#8B5CF6"
                           Margin="0,5,0,0" />

                    <Border BackgroundColor="#0A0A0F" StrokeThickness="1" Stroke="#8B5CF6" Padding="12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                            <RadioButton Grid.Row="0" Grid.Column="0"
                                         x:Name="ModeFastRadio"
                                         GroupName="ScanMode"
                                         Content="⚡ Rapide (14 ports)"
                                         IsChecked="True"
                                         TextColor="#E2E8F0"
                                         FontSize="14"/>
                            <RadioButton Grid.Row="0" Grid.Column="1"
                                         x:Name="ModeFullRadio"
                                         GroupName="ScanMode"
                                         Content="🔎 Complet (illimité)"
                                         TextColor="#E2E8F0"
                                         FontSize="14"/>
                            <RadioButton Grid.Row="0" Grid.Column="2"
                                         x:Name="ModeStealthRadio"
                                         GroupName="ScanMode"
                                         Content="🥷 Furtif (lent)"
                                         TextColor="#E2E8F0"
                                         FontSize="14"/>
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                   x:Name="ModeHintLabel"
                                   Text="Rapide : 14 ports essentiels. Complet : tous les 65 535 ports + deep banner + CVE live NVD. Furtif : délais aléatoires, moins détectable par un IDS."
                                   FontSize="11" TextColor="#64748B" Margin="0,6,0,0"/>
                        </Grid>
                    </Border>
                    
                    <!-- Boutons d'action -->
                    <Grid ColumnDefinitions="*,8,*,8,*" Margin="0,10,0,0">
                        <Button Grid.Column="0"
                                x:Name="ScanButton"
                                Text="🔍 SCANNER" 
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="52"
                                Clicked="OnScanClicked">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#06B6D4" Offset="0.0" />
                                    <GradientStop Color="#8B5CF6" Offset="1.0" />
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>

                        <Button Grid.Column="2"
                                x:Name="ScheduleButton"
                                Text="📅 PROGRAMMER"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="White"
                                BackgroundColor="#8B5CF6"
                                CornerRadius="12"
                                HeightRequest="52"
                                Clicked="OnScheduleClicked"/>
                        
                        <Button Grid.Column="4"
                                x:Name="ExportButton"
                                Text="📄 EXPORT" 
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="White"
                                BackgroundColor="#10B981"
                                CornerRadius="12"
                                HeightRequest="52"
                                Clicked="OnExportClicked"
                                IsEnabled="False"/>
                    </Grid>
                    
                    <!-- Status -->
                    <Border BackgroundColor="#1A1A2E" 
                            Padding="12"
                            StrokeThickness="0"
                            Margin="0,5,0,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <Label x:Name="StatusLabel"
                               Text="⚡ Initialisation..." 
                               FontSize="13" 
                               TextColor="#94A3B8" 
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Cibles invalides -->
                    <Border x:Name="InvalidTargetsPanel"
                            IsVisible="False"
                            BackgroundColor="#3F1D1D"
                            Stroke="#EF4444" StrokeThickness="1"
                            Padding="12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="⚠️ Cibles ignorées (format invalide)" FontSize="12" FontAttributes="Bold" TextColor="#FCA5A5"/>
                            <Label x:Name="InvalidTargetsLabel" FontSize="12" TextColor="#FECACA"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Progression en temps réel -->
                    <Border x:Name="ProgressPanel"
                            IsVisible="False"
                            BackgroundColor="#0F172A"
                            Stroke="#06B6D4" StrokeThickness="1"
                            Padding="14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="10">
                                <Label x:Name="ProgressStatusIcon" Text="⏳" FontSize="18"/>
                                <Label x:Name="ProgressTitleLabel" Text="Scan en cours…"
                                       FontSize="14" FontAttributes="Bold" TextColor="#06B6D4"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <ProgressBar x:Name="ProgressBarUI" Progress="0" ProgressColor="#06B6D4" HeightRequest="6"/>
                            <Label x:Name="ProgressDetailsLabel"
                                   Text=""
                                   FontSize="12" TextColor="#94A3B8"/>
                            <Label x:Name="ProgressElapsedLabel"
                                   Text=""
                                   FontSize="11" TextColor="#64748B"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Résultats avec style moderne -->
            <Border StrokeThickness="2" 
                    Stroke="#06B6D4"
                    BackgroundColor="#16213E"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#06B6D4" Opacity="0.25" Radius="15" Offset="0,3" />
                </Border.Shadow>
                
                <VerticalStackLayout Spacing="15">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="📊" FontSize="22" VerticalOptions="Center" />
                        <Label Text="RÉSULTATS DU SCAN" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="#06B6D4"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    
                    <BoxView HeightRequest="2" 
                             Color="#8B5CF6" 
                             Opacity="0.3"
                             Margin="0,0,0,10" />
                    
                    <ScrollView MaximumHeightRequest="600">
                        <Label x:Name="ResultsLabel"
                               Text="⏳ En attente du premier scan..." 
                               FontSize="14" 
                               TextColor="#CBD5E1"
                               LineBreakMode="WordWrap"
                               LineHeight="1.4" />
                    </ScrollView>
                </VerticalStackLayout>
            </Border>

            <!-- Footer -->
            <Label Text="🛡️ PathFinder - Sécurité Réseau Professionnelle" 
                   FontSize="12" 
                   TextColor="#475569" 
                   HorizontalOptions="Center"
                   Margin="0,10,0,20" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
